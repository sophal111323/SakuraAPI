# ==============================================================================
# SakuraAPI Root Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL - Neon / Supabase / Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sakuraapi?schema=public

# Authentication & Security
JWT_SECRET=sakura_dev_secret_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Upstream Provider Configuration (SoraTopup API)
SORATOPUP_BASE_URL=https://soratopup.com/api/v1
SORATOPUP_API_KEY=your_soratopup_api_key_here

# API Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Upstream Game ID Validation (Bay2Game)
BAY2GAME_CHECKID_URL=https://checkid.bay2game.xyz/check_id
BAY2GAME_API_URL=https://api.bay2game.xyz/api
BAY2GAME_API_KEY=b2g_8c7b36d85f1d018933cad4d31e5d00142c2372c92f26d52f

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="SakuraAPI"
